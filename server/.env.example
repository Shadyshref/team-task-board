NODE_ENV=development
PORT=4000

# Docker/PostgreSQL
POSTGRES_DB=team_task_board
POSTGRES_TEST_DB=team_task_board_test
POSTGRES_USER=team_task_board_user
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

# Backend database connection
DATABASE_URL=postgresql://team_task_board_user:replace_me@localhost:5432/team_task_board?schema=public
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:3000
COOKIE_NAME=access_token
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
